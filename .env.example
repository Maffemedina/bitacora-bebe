# Copia este archivo como .env y completa los valores.
# En Railway estas mismas variables van en la pestaña "Variables" del servicio.

# === Telegram (obligatoria) ===
# Token que te da @BotFather al crear el bot (/newbot).
TELEGRAM_BOT_TOKEN=

# Username del bot (sin @). Se usa para el enlace de invitación de /compartir.
# Ej: mi_bitacora_bebe_bot
TELEGRAM_BOT_USERNAME=

# === Quién puede usar el bot ===
# IDs de Telegram separados por coma (escríbele /mi_id a tu bot para saber el tuyo).
# Vacío = abierto a cualquiera (cada mensaje gasta TU cuota de Gemini).
# Los familiares que entren con un enlace de /compartir quedan permitidos.
ALLOWED_USER_IDS=

# Recordatorios de citas: cuántas horas antes avisar a la familia (0 = apagados).
REMINDER_HOURS=24

# === Gemini (el cerebro del agente) ===
# Crea tu llave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo fijo (no un alias que cambie solo). Opcional.
GEMINI_MODEL=gemini-2.5-flash

# === Zona horaria de la familia (define qué es "hoy") ===
# Ej: America/Bogota, America/Mexico_City, Europe/Madrid
TIMEZONE=America/Bogota

# === Base de datos ===
# En local: SQLite (un archivo). En Railway, al agregar Postgres, usa
# DATABASE_URL=${{Postgres.DATABASE_URL}} (referencia a la variable del plugin).
DATABASE_URL=sqlite+aiosqlite:///./bitacora.db

# === Fotos y videos (opcional) ===
# Carpeta de un volumen persistente. En Railway monta un volumen en /data y pon:
# MEDIA_DIR=/data
# Vacío = se guarda solo la referencia de Telegram.
MEDIA_DIR=

# Alternativa: S3 (opcional, si no usas volumen)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
